# Fork-testing environment. Copy to `.env` (gitignored) and fill in.
#
#   cp .env.example .env
#   $EDITOR .env
#
# Nothing auto-loads this file -- no dotenv dependency in either skill. Source it
# explicitly for the shell that runs the fork commands:
#
#   set -a; . ./.env; set +a
#
# `.env` is gitignored (`.gitignore:2-3`), which is also what keeps it out of
# `envkey.ts`'s leak scanner -- that scan uses `git grep`, so a value in a properly
# gitignored file is the sanctioned case, not a violation (`envkey.ts:52-58`).

# Upstream Base RPC that Anvil forks from. Use an Alchemy-class endpoint, not
# https://mainnet.base.org -- Anvil fetches state per-slot on demand and reading one
# player's full state touches enough slots to get rate-limited hard on a public node.
# Read by: nothing. It is a plain shell variable for the runbook's own `anvil
# --fork-url "$VEYDRIFT_FORK_RPC_URL"` command. See references/fork-testing.md §1.
VEYDRIFT_FORK_RPC_URL=

# Same upstream RPC, read by tests/providers/fork-impersonate.test.ts:38 to gate its
# optional Anvil e2e suite. Unset, that suite skips and `npm test` stays offline.
# Set it to the same value as above.
VEYDRIFT_FORK_TEST_RPC_URL=

# The account `fork-impersonate` impersonates. Read by
# src/providers/fork-impersonate.ts:70. The project's own account is
# 0x224aba5d489675a7bd3ce07786fada466b46fa0f (planet 664).
VEYDRIFT_FORK_IMPERSONATE_ADDRESS=

# Where walletctl points. MUST be loopback for the fork-impersonate provider -- its
# constructor refuses anything else (`refuseIfNotLoopback`). Export it BEFORE any
# walletctl invocation: tx.ts's getPublicClient() memoizes on first call, so changing
# it mid-process does not re-target reads.
VEYDRIFT_RPC_URL=http://127.0.0.1:8545
