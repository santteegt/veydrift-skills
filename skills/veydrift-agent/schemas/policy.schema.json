{
  "$defs": {
    "ActionsCfg": {
      "additionalProperties": false,
      "properties": {
        "allow_acs_defense": {
          "default": false,
          "title": "Allow Acs Defense",
          "type": "boolean"
        },
        "allow_alliance": {
          "default": false,
          "title": "Allow Alliance",
          "type": "boolean"
        },
        "allow_building": {
          "default": true,
          "title": "Allow Building",
          "type": "boolean"
        },
        "allow_combat": {
          "default": false,
          "title": "Allow Combat",
          "type": "boolean"
        },
        "allow_defense": {
          "default": false,
          "title": "Allow Defense",
          "type": "boolean"
        },
        "allow_delegation": {
          "default": false,
          "title": "Allow Delegation",
          "type": "boolean"
        },
        "allow_fleet_noncombat": {
          "default": false,
          "title": "Allow Fleet Noncombat",
          "type": "boolean"
        },
        "allow_research": {
          "default": true,
          "title": "Allow Research",
          "type": "boolean"
        },
        "allow_ships": {
          "default": false,
          "title": "Allow Ships",
          "type": "boolean"
        }
      },
      "title": "ActionsCfg",
      "type": "object"
    },
    "Cadence": {
      "additionalProperties": false,
      "properties": {
        "economy_minutes": {
          "default": 10,
          "title": "Economy Minutes",
          "type": "integer"
        },
        "fleet_minutes": {
          "default": 10,
          "title": "Fleet Minutes",
          "type": "integer"
        },
        "research_minutes": {
          "default": 10,
          "title": "Research Minutes",
          "type": "integer"
        },
        "universe_hours": {
          "default": 24,
          "title": "Universe Hours",
          "type": "integer"
        }
      },
      "title": "Cadence",
      "type": "object"
    },
    "EngineCfg": {
      "additionalProperties": false,
      "description": "Which decision engine proposes each tick's action. `ladder` (default) is `plan.py`'s\nfixed-order ladder; `jev` ranks every legal candidate with TypeSafe's Jev model and falls\nback to the ladder on any error or low-confidence result. Vetoes (killswitch, health,\npause, pending tx, resolvable mission, incoming fleet) and the storage-overflow deadline\nrun first under both engines.",
      "properties": {
        "jev": {
          "$ref": "#/$defs/JevCfg"
        },
        "kind": {
          "default": "ladder",
          "enum": [
            "ladder",
            "jev"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "title": "EngineCfg",
      "type": "object"
    },
    "EntityTarget": {
      "additionalProperties": false,
      "description": "One declared standing-count target (Phase 3 of the general-strategy-engine\nprogram, docs/SPEC.md \u00a75.4/\u00a75.6): \"I want N of this ship/defense.\" Resolved against\n`ids.py`'s `*_NAMES` maps case-insensitively via `name`, or directly via `id` \u2014\nexactly one of the two should be set. `candidates.py` resolves `name` at generation\ntime and raises loudly (`ValueError`) on an unknown name rather than treating it as\n\"no target\" \u2014 `Policy` is `extra=\"forbid\"`, so a typo in a key is already a hard\nstop; a typo in a *value* here must be too, for the same reason.",
      "properties": {
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "title": "EntityTarget",
      "type": "object"
    },
    "EscalationCfg": {
      "additionalProperties": false,
      "properties": {
        "on_abi_hash_change": {
          "default": true,
          "title": "On Abi Hash Change",
          "type": "boolean"
        },
        "on_game_paused": {
          "default": true,
          "title": "On Game Paused",
          "type": "boolean"
        },
        "on_health_unhealthy_minutes": {
          "default": 30,
          "title": "On Health Unhealthy Minutes",
          "type": "integer"
        },
        "on_incoming_fleet": {
          "default": true,
          "title": "On Incoming Fleet",
          "type": "boolean"
        },
        "on_revert_count": {
          "default": 2,
          "title": "On Revert Count",
          "type": "integer"
        }
      },
      "title": "EscalationCfg",
      "type": "object"
    },
    "JevCfg": {
      "additionalProperties": false,
      "description": "Settings for the `jev` decision engine. Read only when `engine.kind == \"jev\"`. The\nTypeSafe API key comes from the `TYPESAFE_API_KEY` environment variable, never from\nthis file, and the API base URL is a code constant, never configurable here.",
      "properties": {
        "adaptive_intent": {
          "default": false,
          "title": "Adaptive Intent",
          "type": "boolean"
        },
        "adaptive_intent_default_hours": {
          "default": 6.0,
          "exclusiveMinimum": 0,
          "maximum": 72,
          "title": "Adaptive Intent Default Hours",
          "type": "number"
        },
        "allow_hold": {
          "default": false,
          "title": "Allow Hold",
          "type": "boolean"
        },
        "high_stakes_only_when_idle": {
          "default": true,
          "title": "High Stakes Only When Idle",
          "type": "boolean"
        },
        "intent": {
          "default": "",
          "maxLength": 1000,
          "title": "Intent",
          "type": "string"
        },
        "max_candidates": {
          "default": 24,
          "maximum": 60,
          "minimum": 2,
          "title": "Max Candidates",
          "type": "integer"
        },
        "min_confidence": {
          "default": 0.5,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Confidence",
          "type": "number"
        },
        "min_confidence_high_stakes": {
          "default": 0.75,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Confidence High Stakes",
          "type": "number"
        },
        "min_margin": {
          "default": 0.03,
          "maximum": 1,
          "minimum": 0,
          "title": "Min Margin",
          "type": "number"
        },
        "model": {
          "default": "jev-latest",
          "title": "Model",
          "type": "string"
        },
        "payback_reference_hours": {
          "default": 24.0,
          "exclusiveMinimum": 0,
          "maximum": 10000,
          "title": "Payback Reference Hours",
          "type": "number"
        },
        "proactive_storage_hours": {
          "default": 24.0,
          "exclusiveMinimum": 0,
          "maximum": 720,
          "title": "Proactive Storage Hours",
          "type": "number"
        },
        "timeout_s": {
          "default": 5.0,
          "maximum": 30,
          "minimum": 0.5,
          "title": "Timeout S",
          "type": "number"
        },
        "weights": {
          "$ref": "#/$defs/JevWeights"
        }
      },
      "title": "JevCfg",
      "type": "object"
    },
    "JevWeights": {
      "additionalProperties": false,
      "description": "Weights `jev_engine` combines per-candidate judgments with (`references/jev-engine.md`).\nEach term is normalised to 0..1 before weighting; the sum is divided out, so only the\nratios matter. `economy` is the only term computed entirely by code (payback hours).",
      "properties": {
        "economy": {
          "default": 0.25,
          "maximum": 100,
          "minimum": 0,
          "title": "Economy",
          "type": "number"
        },
        "fit": {
          "default": 0.3,
          "maximum": 100,
          "minimum": 0,
          "title": "Fit",
          "type": "number"
        },
        "focus": {
          "default": 0.15,
          "maximum": 100,
          "minimum": 0,
          "title": "Focus",
          "type": "number"
        },
        "threat": {
          "default": 0.05,
          "maximum": 100,
          "minimum": 0,
          "title": "Threat",
          "type": "number"
        },
        "urgency": {
          "default": 0.25,
          "maximum": 100,
          "minimum": 0,
          "title": "Urgency",
          "type": "number"
        }
      },
      "title": "JevWeights",
      "type": "object"
    },
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "escalate_above_pct_of_resources": {
          "default": 25,
          "title": "Escalate Above Pct Of Resources",
          "type": "integer"
        },
        "eth_gas_floor_wei": {
          "title": "Eth Gas Floor Wei",
          "type": "integer"
        },
        "field_warn_pct": {
          "default": 80,
          "title": "Field Warn Pct",
          "type": "integer"
        },
        "gas_per_day_wei": {
          "title": "Gas Per Day Wei",
          "type": "integer"
        },
        "gas_per_tx_wei": {
          "title": "Gas Per Tx Wei",
          "type": "integer"
        },
        "max_index_wait_s": {
          "default": 300,
          "title": "Max Index Wait S",
          "type": "integer"
        }
      },
      "required": [
        "gas_per_tx_wei",
        "gas_per_day_wei",
        "eth_gas_floor_wei"
      ],
      "title": "Limits",
      "type": "object"
    },
    "PolicyResources": {
      "additionalProperties": false,
      "description": "`Resources` as it appears inside a policy file (`reserves`, `strategy.resource_weights`):\nsame fields, but unknown keys are rejected. Accepts a plain `Resources` instance too.",
      "properties": {
        "crystal": {
          "default": 0,
          "title": "Crystal",
          "type": "integer"
        },
        "deuterium": {
          "default": 0,
          "title": "Deuterium",
          "type": "integer"
        },
        "metal": {
          "default": 0,
          "title": "Metal",
          "type": "integer"
        }
      },
      "title": "PolicyResources",
      "type": "object"
    },
    "RadarCfg": {
      "additionalProperties": false,
      "description": "Gates the `vd tick` integration of radar.py's incoming-fleet / resolved-attack /\ndebris check, scoped to `policy.planets` (empty == every owned planet, same\nconvention `Policy.planets` already uses for the snapshot itself).\n\nDefault `True` -- a deliberate departure from this codebase's usual \"empty/off ==\nold behaviour\" convention every other `ActionsCfg`/`StrategyCfg` flag follows. Every\none of those flags gates something that can spend gas, move resources, or reach\ncombat; radar is read-only and finds things a tick would otherwise miss silently --\nsee references/radar.md's incident writeup: `snapshot.incoming_fleets` alone missed\na real attack because it only ever lists future arrivals, not resolved ones. Do not\n\"fix\" this default to `False` by pattern-matching the other flags in this file; that\nwould reproduce the exact gap this field exists to close.",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "RadarCfg",
      "type": "object"
    },
    "StorageCfg": {
      "additionalProperties": false,
      "properties": {
        "hours_to_cap_trigger": {
          "default": 2.0,
          "title": "Hours To Cap Trigger",
          "type": "number"
        }
      },
      "title": "StorageCfg",
      "type": "object"
    },
    "StrategyCfg": {
      "additionalProperties": false,
      "description": "Phase 2 (docs/SPEC.md \u00a75.4/\u00a75.6) added `resource_weights`/`max_alternatives`;\nPhase 3 adds the four fields below. All are additive \u2014 an older `policy.json` with\nno `strategy` key, or one that sets `strategy` but omits these newer keys, still\nloads (defaults below reproduce pre-Phase-3 behaviour exactly), but a policy file\nthat sets one of these new keys is rejected by any agent build predating this field\n(`Policy.model_config` is `extra=\"forbid\"`).",
      "properties": {
        "allow_agent_action_override": {
          "default": false,
          "title": "Allow Agent Action Override",
          "type": "boolean"
        },
        "building_priority": {
          "items": {
            "type": "string"
          },
          "title": "Building Priority",
          "type": "array"
        },
        "colonize": {
          "default": false,
          "title": "Colonize",
          "type": "boolean"
        },
        "defense_targets": {
          "items": {
            "$ref": "#/$defs/EntityTarget"
          },
          "title": "Defense Targets",
          "type": "array"
        },
        "enable_crawler": {
          "default": false,
          "title": "Enable Crawler",
          "type": "boolean"
        },
        "fleet_home_planet_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fleet Home Planet Id"
        },
        "max_alternatives": {
          "default": 5,
          "title": "Max Alternatives",
          "type": "integer"
        },
        "planet_rotation": {
          "default": false,
          "title": "Planet Rotation",
          "type": "boolean"
        },
        "production_batch": {
          "default": false,
          "title": "Production Batch",
          "type": "boolean"
        },
        "research_priority": {
          "items": {
            "type": "string"
          },
          "title": "Research Priority",
          "type": "array"
        },
        "resource_weights": {
          "$ref": "#/$defs/PolicyResources"
        },
        "ship_targets": {
          "items": {
            "$ref": "#/$defs/EntityTarget"
          },
          "title": "Ship Targets",
          "type": "array"
        }
      },
      "title": "StrategyCfg",
      "type": "object"
    },
    "Tier": {
      "enum": [
        "advisor",
        "economy",
        "operator"
      ],
      "title": "Tier",
      "type": "string"
    },
    "WalletEngineCfg": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "default": "keystore",
          "enum": [
            "keystore",
            "envkey"
          ],
          "title": "Provider",
          "type": "string"
        },
        "require_confirmation": {
          "default": true,
          "title": "Require Confirmation",
          "type": "boolean"
        }
      },
      "title": "WalletEngineCfg",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "$ref": "#/$defs/ActionsCfg"
    },
    "cadence": {
      "$ref": "#/$defs/Cadence"
    },
    "chain_id": {
      "default": 8453,
      "title": "Chain Id",
      "type": "integer"
    },
    "engine": {
      "$ref": "#/$defs/EngineCfg"
    },
    "escalation": {
      "$ref": "#/$defs/EscalationCfg"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "planets": {
      "items": {
        "type": "integer"
      },
      "title": "Planets",
      "type": "array"
    },
    "radar": {
      "$ref": "#/$defs/RadarCfg"
    },
    "reserves": {
      "$ref": "#/$defs/PolicyResources"
    },
    "signer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signer"
    },
    "storage": {
      "$ref": "#/$defs/StorageCfg"
    },
    "strategy": {
      "$ref": "#/$defs/StrategyCfg"
    },
    "tier": {
      "$ref": "#/$defs/Tier",
      "default": "advisor"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "wallet": {
      "title": "Wallet",
      "type": "string"
    },
    "wallet_engine": {
      "$ref": "#/$defs/WalletEngineCfg"
    }
  },
  "required": [
    "wallet",
    "limits"
  ],
  "title": "Policy",
  "type": "object"
}
