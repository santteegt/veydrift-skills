{
  "$defs": {
    "ActionsCfg": {
      "properties": {
        "allow_building": {
          "default": true,
          "title": "Allow Building",
          "type": "boolean"
        },
        "allow_combat": {
          "default": false,
          "title": "Allow Combat",
          "type": "boolean"
        },
        "allow_defense": {
          "default": false,
          "title": "Allow Defense",
          "type": "boolean"
        },
        "allow_fleet_noncombat": {
          "default": false,
          "title": "Allow Fleet Noncombat",
          "type": "boolean"
        },
        "allow_research": {
          "default": true,
          "title": "Allow Research",
          "type": "boolean"
        },
        "allow_ships": {
          "default": false,
          "title": "Allow Ships",
          "type": "boolean"
        }
      },
      "title": "ActionsCfg",
      "type": "object"
    },
    "Cadence": {
      "properties": {
        "economy_minutes": {
          "default": 10,
          "title": "Economy Minutes",
          "type": "integer"
        },
        "fleet_minutes": {
          "default": 10,
          "title": "Fleet Minutes",
          "type": "integer"
        },
        "research_minutes": {
          "default": 10,
          "title": "Research Minutes",
          "type": "integer"
        },
        "universe_hours": {
          "default": 24,
          "title": "Universe Hours",
          "type": "integer"
        }
      },
      "title": "Cadence",
      "type": "object"
    },
    "EntityTarget": {
      "description": "One declared standing-count target (Phase 3 of the general-strategy-engine\nprogram, docs/SPEC.md \u00a75.4/\u00a75.6): \"I want N of this ship/defense.\" Resolved against\n`ids.py`'s `*_NAMES` maps case-insensitively via `name`, or directly via `id` \u2014\nexactly one of the two should be set. `candidates.py` resolves `name` at generation\ntime and raises loudly (`ValueError`) on an unknown name rather than treating it as\n\"no target\" \u2014 `Policy` is `extra=\"forbid\"`, so a typo in a key is already a hard\nstop; a typo in a *value* here must be too, for the same reason.",
      "properties": {
        "count": {
          "default": 0,
          "title": "Count",
          "type": "integer"
        },
        "id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        }
      },
      "title": "EntityTarget",
      "type": "object"
    },
    "EscalationCfg": {
      "properties": {
        "on_abi_hash_change": {
          "default": true,
          "title": "On Abi Hash Change",
          "type": "boolean"
        },
        "on_health_unhealthy_minutes": {
          "default": 30,
          "title": "On Health Unhealthy Minutes",
          "type": "integer"
        },
        "on_incoming_fleet": {
          "default": true,
          "title": "On Incoming Fleet",
          "type": "boolean"
        },
        "on_revert_count": {
          "default": 2,
          "title": "On Revert Count",
          "type": "integer"
        }
      },
      "title": "EscalationCfg",
      "type": "object"
    },
    "Limits": {
      "properties": {
        "escalate_above_pct_of_resources": {
          "default": 25,
          "title": "Escalate Above Pct Of Resources",
          "type": "integer"
        },
        "eth_gas_floor_wei": {
          "title": "Eth Gas Floor Wei",
          "type": "integer"
        },
        "field_warn_pct": {
          "default": 80,
          "title": "Field Warn Pct",
          "type": "integer"
        },
        "gas_per_day_wei": {
          "title": "Gas Per Day Wei",
          "type": "integer"
        },
        "gas_per_tx_wei": {
          "title": "Gas Per Tx Wei",
          "type": "integer"
        },
        "max_index_wait_s": {
          "default": 300,
          "title": "Max Index Wait S",
          "type": "integer"
        }
      },
      "required": [
        "gas_per_tx_wei",
        "gas_per_day_wei",
        "eth_gas_floor_wei"
      ],
      "title": "Limits",
      "type": "object"
    },
    "Resources": {
      "description": "A metal/crystal/deuterium triple. Used for holdings, costs, caps and reserves.",
      "properties": {
        "crystal": {
          "default": 0,
          "title": "Crystal",
          "type": "integer"
        },
        "deuterium": {
          "default": 0,
          "title": "Deuterium",
          "type": "integer"
        },
        "metal": {
          "default": 0,
          "title": "Metal",
          "type": "integer"
        }
      },
      "title": "Resources",
      "type": "object"
    },
    "StorageCfg": {
      "properties": {
        "hours_to_cap_trigger": {
          "default": 2.0,
          "title": "Hours To Cap Trigger",
          "type": "number"
        }
      },
      "title": "StorageCfg",
      "type": "object"
    },
    "StrategyCfg": {
      "description": "Phase 2 (docs/SPEC.md \u00a75.4/\u00a75.6) added `resource_weights`/`max_alternatives`;\nPhase 3 adds the four fields below. All are additive \u2014 an older `policy.json` with\nno `strategy` key, or one that sets `strategy` but omits these newer keys, still\nloads (defaults below reproduce pre-Phase-3 behaviour exactly), but a policy file\nthat sets one of these new keys is rejected by any agent build predating this field\n(`Policy.model_config` is `extra=\"forbid\"`).",
      "properties": {
        "building_priority": {
          "items": {
            "type": "string"
          },
          "title": "Building Priority",
          "type": "array"
        },
        "defense_targets": {
          "items": {
            "$ref": "#/$defs/EntityTarget"
          },
          "title": "Defense Targets",
          "type": "array"
        },
        "max_alternatives": {
          "default": 5,
          "title": "Max Alternatives",
          "type": "integer"
        },
        "research_priority": {
          "items": {
            "type": "string"
          },
          "title": "Research Priority",
          "type": "array"
        },
        "resource_weights": {
          "$ref": "#/$defs/Resources"
        },
        "ship_targets": {
          "items": {
            "$ref": "#/$defs/EntityTarget"
          },
          "title": "Ship Targets",
          "type": "array"
        }
      },
      "title": "StrategyCfg",
      "type": "object"
    },
    "Tier": {
      "enum": [
        "advisor",
        "economy",
        "operator"
      ],
      "title": "Tier",
      "type": "string"
    },
    "WalletEngineCfg": {
      "properties": {
        "provider": {
          "default": "keystore",
          "enum": [
            "keystore",
            "envkey"
          ],
          "title": "Provider",
          "type": "string"
        },
        "require_confirmation": {
          "default": true,
          "title": "Require Confirmation",
          "type": "boolean"
        }
      },
      "title": "WalletEngineCfg",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "actions": {
      "$ref": "#/$defs/ActionsCfg"
    },
    "cadence": {
      "$ref": "#/$defs/Cadence"
    },
    "chain_id": {
      "default": 8453,
      "title": "Chain Id",
      "type": "integer"
    },
    "escalation": {
      "$ref": "#/$defs/EscalationCfg"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    },
    "planets": {
      "items": {
        "type": "integer"
      },
      "title": "Planets",
      "type": "array"
    },
    "reserves": {
      "$ref": "#/$defs/Resources"
    },
    "storage": {
      "$ref": "#/$defs/StorageCfg"
    },
    "strategy": {
      "$ref": "#/$defs/StrategyCfg"
    },
    "tier": {
      "$ref": "#/$defs/Tier",
      "default": "advisor"
    },
    "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "wallet": {
      "title": "Wallet",
      "type": "string"
    },
    "wallet_engine": {
      "$ref": "#/$defs/WalletEngineCfg"
    }
  },
  "required": [
    "wallet",
    "limits"
  ],
  "title": "Policy",
  "type": "object"
}
